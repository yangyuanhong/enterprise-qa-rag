# 复制为 .env 后按需修改；未配置的项使用 config.py 里的默认值

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_enterprise_qa
DB_USER=root
DB_PASSWORD=

# ---------- JWT ----------
# 正式环境务必换成随机字符串
JWT_SECRET=dev-secret
JWT_EXPIRE_HOURS=24

# ---------- Ollama 模型 ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:4b
# 留空则不识别文档中的图片
VISION_MODEL=qwen3-vl:8b-instruct

# ---------- Chroma 向量库 ----------
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=enterprise_kb

# ---------- RAG 参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
# 与 embedding 模型强相关，换模型后用 scripts/eval_threshold.py 重新测定
SCORE_THRESHOLD=0.45

# ---------- Rerank 重排序 ----------
# 留空则不启用 rerank（此时改用 SCORE_THRESHOLD 过滤）
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=20
RERANK_THRESHOLD=0.3
# 关键词命中的片段数超过该值时视为常见词，不作为检索关键词
KEYWORD_MAX_HITS=3
MODEL_CACHE_DIR=models_cache

# ---------- 图片识别 ----------
# 宽或高小于该像素的图片视为装饰，不识别
IMAGE_MIN_SIZE=100
